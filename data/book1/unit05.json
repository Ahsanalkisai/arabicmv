    },
    {
     "who": "الْمُسَافِرُ",
     "ar": "أَطْلُبُ السَّمَكَ وَالْأَرُزَّ مِنْ فَضْلِكِ.",
     "en": "I would like fish and rice, please.",
     "dv": "މަހާއި ބަތް ބޭނުން."
    },
    {
     "who": "الْمُضِيفَةُ",
     "ar": "وَمَاذَا تَطْلُبُ مِنَ الشَّرَابِ؟",
