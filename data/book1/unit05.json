  {
   "lesson": 3,
   "audio": null,
   "lines": [
    {
     "who": "الزَّوْجُ",
     "ar": "السَّلَامُ عَلَيْكُمْ. أَنَا جَوْعَانُ جِدًّا.",
     "en": "Peace be upon you. I am very hungry.",
     "dv": "ތިޔަބޭކަލުންނަށް ސަލާމް. އަހަރެން ވަރަށް ބަނޑުހައި."
    },
    {
     "who": "الزَّوْجَةُ",
     "ar": "وَعَلَيْكُمُ السَّلَامُ. الْعَشَاءُ عَلَى الْمَائِدَةِ.",
     "en": "And upon you be peace. Dinner is on the table.",
     "dv": "ތިޔަބޭކަލުންނަށްވެސް ސަލާމް. ރޭގަނޑުގެ ކެއުން ހުރީ ކާމޭޒުމަތީގައި."
    },
    {
     "who": "الزَّوْجُ",
     "ar": "مَا شَاءَ اللهُ! دَجَاجٌ وَلَحْمٌ وَأَرُزٌّ وَسَلَطَةٌ! هَذَا كَثِيرٌ جِدًّا.",
     "en": "Masha Allah! Chicken, meat, rice and salad! This is a lot.",
     "dv": "މާޝާﷲ! ކުކުޅާއި، މަހާއި، ބަތާއި، ސެލެޑު! މިއީ ވަރަށް ގިނަ."
    },
    {
     "who": "الزَّوْجَةُ",
     "ar": "لَا تَأْكُلِ الْآنَ. اِجْلِسْ مِنْ فَضْلِكَ.",
     "en": "Don't eat now. Please sit down.",
     "dv": "މިހާރު ނުކާތި. އިށީނދެލާ."
    },
    {
     "who": "الزَّوْجُ",
     "ar": "لِمَاذَا؟ أَنَا جَوْعَانُ!",
     "en": "Why? I am hungry!",
     "dv": "ކީއްވެ؟ އަހަރެން ބަނޑުހައި!"
    },
