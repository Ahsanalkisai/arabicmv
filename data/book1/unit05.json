    {
     "who": "حَسَنٌ",
     "ar": "إِلَى أَيْنَ تَذْهَبُ يَا سَعِيدُ؟",
     "en": "Where are you going, Saeed?",
     "dv": "ސަޢީދު، ތިބާ ދަނީ ކޮންތާކަށް؟"
    },
    {
     "who": "سَعِيدٌ",
     "ar": "أَذْهَبُ إِلَى الْمَطْعَمِ.",
     "en": "I am going to the restaurant.",
     "dv": "އަހަރެން ދަނީ ރެސްޓޯރަންޓަށް."
    },
    {
     "who": "حَسَنٌ",
     "ar": "كَمْ وَجْبَةً تَأْكُلُ فِي الْيَوْمِ؟",
     "en": "How many meals do you eat a day?",
     "dv": "ދުވާލަކު ކިތައް ފަހަރު ކަން؟"
    },
    {
     "who": "سَعِيدٌ",
     "ar": "آكُلُ ثَلَاثَ وَجَبَاتٍ: الْفَطُورَ وَالْغَدَاءَ وَالْعَشَاءَ. وَأَنْتَ؟",
     "en": "I eat three meals: breakfast, lunch and dinner. And you?",
     "dv": "އަހަރެން ތިން ފަހަރު ކަން: ހެނދުނުގެ ނާސްތާއާއި، މެންދުރުގެ ކެއުމާއި، ރޭގަނޑުގެ ކެއުން. ތިބާ؟"
    },
    {
     "who": "حَسَنٌ",
     "ar": "أَنَا آكُلُ وَجْبَةً وَاحِدَةً.",
     "en": "I eat one meal.",
     "dv": "އަހަރެން ކަނީ އެންމެ ފަހަރަކު."
    },
    {
     "who": "سَعِيدٌ",
     "ar": "هَذَا قَلِيلٌ جِدًّا! مَاذَا تَأْكُلُ فِي الْغَدَاءِ؟",
     "en": "That is very little! What do you eat for lunch?",
     "dv": "އެއީ ވަރަށް މަދު! މެންދުރަށް ތިބާ ކަނީ ކޯއްޗެއް؟"
    },
    {
     "who": "حَسَنٌ",
     "ar": "آكُلُ السَّمَكَ وَالْأَرُزَّ وَالْفَاكِهَةَ. وَمَاذَا تَأْكُلُ أَنْتَ؟",
     "en": "I eat fish, rice and fruit. And what do you eat?",
     "dv": "އަހަރެން ކަނީ މަހާއި، ބަތާއި، މޭވާ. ތިބާ ކަނީ ކޯއްޗެއް؟"
    },
    {
     "who": "سَعِيدٌ",
     "ar": "آكُلُ الْخُبْزَ وَاللَّحْمَ وَالْأَرُزَّ.",
     "en": "I eat bread, meat and rice.",
     "dv": "އަހަރެން ކަނީ ރޮށްޓާއި، މަހާއި، ބަތް."
    },
    {
